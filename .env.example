# Sonarr configuration
SONARR_API_KEY=your_sonarr_api_key_here
SONARR_URL=http://sonarr:8989

# Radarr configuration
RADARR_API_KEY=your_radarr_api_key_here
RADARR_URL=http://radarr:7878

# Paths for downloaded content
MOVIES_PATH=/path/to/your/movies
TV_PATH=/path/to/your/tv

# Logging level
LOG_LEVEL=INFO

# API key Sonarr and Radarr send to the Newznab indexer and the SABnzbd client.
# Leave blank to generate one in /config/api_key on first start.
INDEXER_API_KEY=
